    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 6px;
    height: 100%;
    transition: transform 0.24s ease;
}

.player-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.player-card-center {
    display: grid;
    place-items: center;
    text-align: center;
}

.player-card-face:not(.player-card-back) {
    transform: rotateY(0deg);
}

.player-card.revealed .player-card-face:not(.player-card-back) {
    transform: rotateY(-180deg);
}

.player-card-back {
    transform: rotateY(180deg);
    background: linear-gradient(180deg, var(--surface-accent) 0%, var(--white) 90%);
}

.player-card.revealed .player-card-back {
    transform: rotateY(0deg);
}

.vote-placeholder {
    color: var(--muted);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
}

.vote-check {
    color: var(--text-success-strong);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid rgba(26, 127, 55, 0.25);
    background: var(--surface-success);
    border-radius: 999px;
    padding: 4px 10px;
}

.vote-value {
    font-size: 32px;
    font-weight: 800;
    line-height: 1;
}

.vote-label {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.card-palette {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
    gap: 8px;
}

.vote-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    min-height: 64px;
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 700;
    background: var(--white);
    cursor: pointer;
    transition: all 0.16s ease;
    user-select: none;
}

.vote-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
}

.vote-card:active {
    transform: translateY(0);
}

.vote-card.selected {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.18);
    color: var(--text-accent-strong);
    transform: translateY(-2px);
}

.notice {
    border-radius: var(--radius-md);
    font-size: 13px;
    display: block;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    padding: 0 12px;
    transform: translateY(-2px);
    transition: opacity 0.2s ease, max-height 0.2s ease, padding 0.2s ease, transform 0.2s ease;
}

.notice.visible {
    opacity: 1;
    max-height: 140px;
    padding: 10px 12px;
    transform: translateY(0);
}

.notice.info {
    background: var(--surface-info);
    color: var(--text-info);
}

.notice.warn {
    background: var(--surface-warning);
    color: var(--text-warning);
}

.notice.error {
    background: var(--surface-danger);
    color: var(--text-danger);
}

.mono {
    font-family: "SF Mono", Monaco, "Courier New", monospace;
}

.join-link-status-panel {
    display: grid;
    gap: 12px;
}

.join-link-status-card {
    display: grid;
    gap: 8px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--panel);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
}

.join-link-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--border);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: join-link-spin 0.8s linear infinite;
}

.join-link-room-code {
    font-size: 14px;
    color: var(--muted);
    background: var(--surface-muted);
    padding: 8px 10px;
    border-radius: var(--radius-md);
}

.join-link-subtext {
    min-height: 1.2em;
}

@keyframes join-link-spin {
    to {
        transform: rotate(360deg);
    }
}

.settings-dialog {
    border: none;
    border-radius: var(--radius-lg);
    padding: 0;
    max-width: 760px;
    width: calc(100% - 24px);
    box-shadow: 0 16px 60px rgba(0, 0, 0, 0.25);
}

.settings-dialog::backdrop {
    background: rgba(0, 0, 0, 0.42);
}

.settings-stack {
    display: grid;
    gap: 16px;
    padding: 20px;
    background: var(--white);
    border-radius: var(--radius-lg);
}

.room-qr-image {
    width: 140px;
    height: 140px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
}

.manual-fallback-details > summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
    list-style: none;
}

.manual-fallback-details > summary::-webkit-details-marker {
    display: none;
}

.manual-fallback-details > summary::before {
    content: "▸ ";
    color: var(--muted);
}

.manual-fallback-details[open] > summary::before {
    content: "▾ ";
}

.manual-fallback-details[open] > summary {
    margin-bottom: 12px;
}

#hostRoomAccessPanel > #hostLobbyNotice {
    margin-bottom: 4px;
}

#hostRoomAccessPanel > #hostLobbyNotice.visible {
    margin-bottom: 8px;
}

.pending-rejoin-banner {
    display: grid;
    gap: 10px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--surface-warning);
    border: 1px solid #f0d9a8;
    border-left: 4px solid var(--warning);
    color: var(--text-warning-strong);
}

.pending-rejoin-banner[hidden] {
    display: none !important;
}


