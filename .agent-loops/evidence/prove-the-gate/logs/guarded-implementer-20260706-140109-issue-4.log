    font-size: 12px;
}

.btn:active:not(:disabled) {
    transform: translateY(1px);
}

.btn.copied {
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
}

.btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.btn-primary {
    background: var(--primary);
    color: var(--white);
}

.btn-primary:hover:not(:disabled) {
    background: var(--primary-hover);
}

.btn-secondary {
    background: var(--secondary-btn);
